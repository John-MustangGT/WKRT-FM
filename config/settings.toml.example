[station]
call_sign = "WKRT"
frequency = "104.7"
tagline = "The Home of Classic Rock"
city = "Boston"
timezone = "America/New_York"

[paths]
music_dir = "./music"
spool_dir = "./spool"
dj_clips_dir = "./dj_clips"
voices_dir = "./voices"
log_dir = "./logs"

[logging]
# Write logs to files under log_dir in addition to stdout/journald.
# Disabled by default — journald already captures all output when running
# under systemd, so file logs are redundant in production.
file_logging = false
# Days of rolled log files to keep (only relevant when file_logging = true).
# Logs rotate daily at midnight and on every restart.  The active file is
# always logs/wkrt.log; rolled files are named wkrt.log.YYYY-MM-DD.
keep_days = 10

[playlist]
# How many tracks to pre-generate ahead in the spool
lookahead = 3
# Insert DJ clip every N tracks (0 = never, 1 = every track)
dj_every_n_tracks = 3
# How many recently played tracks to exclude from the candidate pool
# recent_exclude = 10
# Crossfade duration in seconds
crossfade_seconds = 3
# Fade out duration at end of track before DJ clip
fade_out_seconds = 2
# How many seconds before track end Roxanne starts talking over the fade
# Set to 0 to disable talkover (DJ speaks after track ends)
dj_talkover_seconds = 8
# Seconds of silence to trim from start/end of tracks
trim_silence = true

# Year weights — higher = played more often
# Default is equal weight across all years
[playlist.year_weights]
1980 = 1.0
1981 = 1.0
1982 = 1.0
1983 = 1.0
1984 = 1.5   # peak year, play more
1985 = 1.5
1986 = 1.5
1987 = 2.0   # glam metal peak
1988 = 2.0
1989 = 1.5

[dj]
# DJ persona fed to Claude
persona = """
You are Roxanne, the afternoon drive DJ on WKRT 104.7, Boston's home of classic rock.
Your style: warm, slightly husky voice, dry wit, encyclopedic rock knowledge.
You love the 80s but aren't cheesy about it. You drop real facts and trivia.
You occasionally reference Boston, the weather, or the commute.
Keep it authentic — like a real radio DJ, not a parody of one.
Never use phrases like 'totally', 'awesome', or 'rock on'.
"""

# Probability of different DJ clip types (must sum to 1.0)
[dj.clip_types]
between_tracks = 0.60     # standard between-song banter
trivia = 0.20             # rock trivia / artist fact
dedication = 0.10         # fake listener dedication
station_id = 0.10         # call sign / time / weather

[tts]
# Piper voice model to use
voice_model = "en_US-lessac-high"
# Speed (1.0 = normal, 0.9 = slightly slower/warmer)
speed = 0.92
# Noise scale (lower = cleaner, higher = more natural variation)
noise_scale = 0.667
noise_w = 0.8

[api]
# Anthropic API key — can also set ANTHROPIC_API_KEY env var
api_key = "your-anthropic-api-key-here"
model = "claude-haiku-4-5-20251001"
max_tokens = 300

[output]
# Audio format for stitched output segments
format = "mp3"
bitrate = "192k"
sample_rate = 44100
channels = 2

[web]
port = 8080

[icecast]
host = "localhost"
port = 8000
mount = "/wkrt"
source_password = "your-icecast-source-password"
hook_port = 8765          # local port for listener connect/disconnect events

[icecast.stream]
name = "WKRT-FM 104.7"
description = "The Home of Classic Rock"
genre = "Classic Rock"
bitrate = 192

# ─────────────────────────────────────────────────────────────────────────────
# DJ roster — add one [[djs]] block per on-air personality.
# shift_hours controls how many hours of the 24-hour rotation each DJ covers.
# api_backend defaults to "anthropic" (Claude). Set to "azure_openai" to use
# Azure OpenAI (GPT-4o, etc.) instead — great for a Copilot-powered DJ.
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic / Claude DJ (default) ──────────────────────────────────────────
[[djs]]
name        = "Roxanne"
shift_hours = 12
tts_backend = "piper"
# api_backend defaults to "anthropic" — uses the global [api] key + model
persona = """
You are Roxanne, the afternoon drive DJ on WKRT 104.7, Boston's home of classic rock.
Your style: warm, slightly husky voice, dry wit, encyclopedic rock knowledge.
You love the 80s but aren't cheesy about it. You drop real facts and trivia.
Keep it authentic — like a real radio DJ, not a parody of one.
"""

[djs.clip_types]
between_tracks = 0.60
trivia         = 0.20
dedication     = 0.10
station_id     = 0.10

[djs.tts]
voice_model = "en_US-lessac-high"
speed       = 0.92
noise_scale = 0.667
noise_w     = 0.8
# Per-DJ pronunciation overrides for Piper/espeak-ng.
# These are applied on top of the built-in table in wkrt/tts.py.
# Use phonetic spellings that espeak-ng renders the way you want.
# pronounce = { "Scorpions" = "Score-pee-ons", "Foreigner" = "For-ner" }

# ── Azure OpenAI DJ (Copilot-powered) ────────────────────────────────────────
# Requires:  pip install openai
# Azure credentials can also be set via env vars:
#   AZURE_OPENAI_ENDPOINT   → overrides azure.endpoint
#   AZURE_OPENAI_API_KEY    → overrides azure.api_key
# Get these from your Azure OpenAI resource → Keys and Endpoint in the portal.
# The deployment name must match one you've created in Azure AI Studio.
#
# [[djs]]
# name        = "Neon"
# shift_hours = 12
# tts_backend = "google"             # or "piper" — independent of api_backend
# api_backend = "azure_openai"       # <── this is the key line
# persona = """
# You are Neon, the overnight DJ on WKRT 104.7. You're cool, a little mysterious,
# with an encyclopedic knowledge of synth-pop and hard rock deep cuts.
# You keep the city company through the small hours. Never corny.
# """
#
# [djs.clip_types]
# between_tracks = 0.55
# trivia         = 0.25
# dedication     = 0.10
# station_id     = 0.10
#
# [djs.tts]
# google_voice   = "en-US-Studio-M"
# speaking_rate  = 1.0

# ── Example: Overnight DJ running on local Ollama (no API key required) ───────
# A spare, no-frills voice that holds down the late shift while the main DJs rest.
# Runs entirely on-device — good for Pi/LXC deployments with Ollama installed.
#
# [[djs]]
# name        = "Static"
# shift_hours = 8                    # e.g. 22:00–06:00
# tts_backend = "piper"
# api_backend = "ollama"
# persona = """
# You are Static, the overnight automation DJ on WKRT 104.7.
# You are sparse and unfussy — a steady hand through the small hours.
# No jokes. No hype. Just the facts: artist, song, year, call sign.
# One or two sentences max. Keep the city company without waking it up.
# """
#
# [djs.clip_types]
# between_tracks = 0.50
# trivia         = 0.15
# dedication     = 0.05
# station_id     = 0.30             # lean on station IDs — reliable without a good model
#
# [djs.tts]
# voice_model = "en_US-lessac-high"
# speed       = 0.88               # slightly slower for late-night feel
#
# [djs.ollama]
# host       = "localhost"          # Ollama host (or LAN IP)
# port       = 11434
# model      = "llama3"             # any model pulled via `ollama pull <model>`
# max_tokens = 120                  # keep it short — this DJ doesn't ramble
#
# [djs.azure]
# endpoint    = "https://YOUR-RESOURCE-NAME.openai.azure.com/"
# api_key     = "your-azure-openai-api-key"
# deployment  = "gpt-4o"             # name of your deployment in Azure AI Studio
# api_version = "2024-02-01"         # Azure OpenAI API version
# max_tokens  = 300                  # optional — overrides global [api].max_tokens

# ── Kokoro ONNX DJ (local neural TTS, no cloud or binary required) ────────────
# Requires:  pip install kokoro-onnx soundfile
# Download model files from https://huggingface.co/hexgrad/Kokoro-82M:
#   kokoro-v0_19.onnx  → voices/kokoro-v0_19.onnx
#   voices.bin         → voices/kokoro-voices.bin
# Available voices: af_heart, af_bella, af_sky, af_nicole,
#                   am_adam, am_michael, bm_lewis, bf_emma
#
# [[djs]]
# name        = "Echo"
# shift_hours = 12
# tts_backend = "kokoro"
# persona = """
# You are Echo, the midday DJ on WKRT 104.7.
# You're energetic, warm, and love classic rock deep cuts.
# Keep it real — one or two sentences, no filler.
# """
#
# [djs.clip_types]
# between_tracks = 0.60
# trivia         = 0.20
# dedication     = 0.10
# station_id     = 0.10
#
# [djs.tts]
# kokoro_voice  = "af_heart"           # voice name from Kokoro
# kokoro_model  = "kokoro-v0_19.onnx"  # relative to voices_dir
# kokoro_voices = "kokoro-voices.bin"  # relative to voices_dir
# speed         = 1.0                  # speaking rate (0.5–2.0)
# lang          = "en-us"              # language code

# ── Discord webhook (optional) ────────────────────────────────────────────────
# Post now-playing embeds to a Discord channel.
# 1. In Discord: Edit Channel → Integrations → Webhooks → New Webhook → Copy URL
# 2. Paste the URL below and uncomment.
#
# [discord]
# webhook_url    = "https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN"
# username       = "WKRT-FM 104.7"   # display name in Discord (optional)
# avatar_url     = ""                 # bot avatar URL (optional)
# post_dj_script = false              # also post DJ break quotes to Discord
